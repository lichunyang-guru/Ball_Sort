--- !u!114 &3000001001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1247928832}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86f9205579c3440279820de33163ea4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageTexts:
  - language: 0
    text: Help ons!
  - language: 1
    text: "\u0633\u0627\u0639\u062F\u0648\u0646\u0627!"
  - language: 2
    text: Lagundu iezaguzu!
  - language: 3
    text: "\u0414\u0430\u043F\u0430\u043C\u0430\u0436\u044B\u0446\u0435 \u043D\u0430\u043C!"
  - language: 4
    text: "\u041F\u043E\u043C\u043E\u0433\u043D\u0435\u0442\u0435 \u043D\u0438!"
  - language: 5
    text: "Ajuda\u2019ns!"
  - language: 6
    text: "\u5E2E\u5E2E\u6211\u4EEC\uFF01"
  - language: 7
    text: "Pomozte n\xE1m!"
  - language: 8
    text: "Hj\xE6lp os!"
  - language: 9
    text: Help ons!
  - language: 10
    text: Help us!
  - language: 11
    text: Aidake meid!
  - language: 12
    text: "Hj\xE1lpi\xF0 okkum!"
  - language: 13
    text: "Auttakaa meit\xE4!"
  - language: 14
    text: Aidez-nous !
  - language: 15
    text: Helft uns!
  - language: 16
    text: "\u0392\u03BF\u03B7\u03B8\u03AE\u03C3\u03C4\u03B5 \u03BC\u03B1\u03C2!"
  - language: 17
    text: "\u05E2\u05D6\u05E8\u05D5 \u05DC\u05E0\u05D5!"
  - language: 18
    text: "Seg\xEDtsetek!"
  - language: 19
    text: "Hj\xE1lpi\xF0 okkur!"
  - language: 20
    text: Tolong kami!
  - language: 21
    text: Aiutateci!
  - language: 22
    text: "\u52A9\u3051\u3066\uFF01"
  - language: 23
    text: "\uB3C4\uC640\uC8FC\uC138\uC694!"
  - language: 24
    text: "Pal\u012Bdziet mums!"
  - language: 25
    text: "Pad\u0117kite mums!"
  - language: 26
    text: Hjelp oss!
  - language: 27
    text: "Pom\xF3\u017C nam!"
  - language: 28
    text: Ajuda-nos!
  - language: 29
    text: "Ajuta\u021Bi-ne!"
  - language: 30
    text: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043D\u0430\u043C!"
  - language: 31
    text: Pomozite nam!
  - language: 32
    text: "Pom\xF4\u017Ete n\xE1m!"
  - language: 33
    text: Pomagajte nam!
  - language: 34
    text: "\xA1Ay\xFAdanos!"
  - language: 35
    text: "Hj\xE4lp oss!"
  - language: 36
    text: "\u0E0A\u0E48\u0E27\u0E22\u0E1E\u0E27\u0E01\u0E40\u0E23\u0E32\u0E14\u0E49\u0E27\u0E22!"
  - language: 37
    text: "Bize yard\u0131m et!"
  - language: 38
    text: "\u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C \u043D\u0430\u043C!"
  - language: 39
    text: "Gi\xFAp ch\xFAng t\xF4i v\u1EDBi!"
  - language: 40
    text: "\u5E2E\u5E2E\u6211\u4EEC\uFF01"
  - language: 41
    text: "\u5E6B\u5E6B\u6211\u5011\uFF01"
  - language: 42
    text: "\u0939\u092E\u093E\u0930\u0940 \u092E\u0926\u0926 \u0915\u0930\u0947\u0902!"
--- !u!114 &3000001002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1663462386}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86f9205579c3440279820de33163ea4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageTexts:
  - language: 0
    text: Ons is gevries!
  - language: 1
    text: "\u0644\u0642\u062F \u062A\u062C\u0645\u062F\u0646\u0627!"
  - language: 2
    text: Izoztuta gaude!
  - language: 3
    text: "\u041C\u044B \u0437\u0430\u043C\u0435\u0440\u0437\u043B\u0456!"
  - language: 4
    text: "\u0417\u0430\u043C\u0440\u044A\u0437\u043D\u0430\u043B\u0438 \u0441\u043C\u0435!"
  - language: 5
    text: Estem congelades!
  - language: 6
    text: "\u6211\u4EEC\u88AB\u51BB\u4F4F\u4E86\uFF01"
  - language: 7
    text: "Jsme zmrzl\xE9!"
  - language: 8
    text: Vi er frosset fast!
  - language: 9
    text: We zijn bevroren!
  - language: 10
    text: We are frozen!
  - language: 11
    text: "Oleme k\xFClmunud!"
  - language: 12
    text: Vit eru fryst!
  - language: 13
    text: "Olemme j\xE4\xE4ss\xE4!"
  - language: 14
    text: "Nous sommes gel\xE9es !"
  - language: 15
    text: Wir sind eingefroren!
  - language: 16
    text: "\u0388\u03C7\u03BF\u03C5\u03BC\u03B5 \u03C0\u03B1\u03B3\u03CE\u03C3\u03B5\u03B9!"
  - language: 17
    text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E7\u05E4\u05D5\u05D0\u05D5\u05EA!"
  - language: 18
    text: Megfagytunk!
  - language: 19
    text: "Vi\xF0 erum frosnar!"
  - language: 20
    text: Kami membeku!
  - language: 21
    text: Siamo congelate!
  - language: 22
    text: "\u51CD\u3063\u3061\u3083\u3063\u305F\uFF01"
  - language: 23
    text: "\uC6B0\uB9AC\uAC00 \uC5BC\uC5B4\uBD99\uC5C8\uC5B4\uC694!"
  - language: 24
    text: "M\u0113s esam sasalu\u0161as!"
  - language: 25
    text: "Mes su\u0161alusios!"
  - language: 26
    text: Vi er frosset fast!
  - language: 27
    text: "Jeste\u015Bmy zamro\u017Cone!"
  - language: 28
    text: Estamos congeladas!
  - language: 29
    text: "Suntem \xEEnghe\u021Bate!"
  - language: 30
    text: "\u041C\u044B \u0437\u0430\u043C\u0451\u0440\u0437\u043B\u0438!"
  - language: 31
    text: Smrznute smo!
  - language: 32
    text: "Sme zamrznut\xE9!"
  - language: 33
    text: Zamrznile smo!
  - language: 34
    text: "\xA1Estamos congeladas!"
  - language: 35
    text: "Vi \xE4r fastfrusna!"
  - language: 36
    text: "\u0E1E\u0E27\u0E01\u0E40\u0E23\u0E32\u0E16\u0E39\u0E01\u0E41\u0E0A\u0E48\u0E41\u0E02\u0E47\u0E07!"
  - language: 37
    text: "Donduk kald\u0131k!"
  - language: 38
    text: "\u041C\u0438 \u0437\u0430\u043C\u0435\u0440\u0437\u043B\u0438!"
  - language: 39
    text: "Ch\xFAng t\xF4i b\u1ECB \u0111\xF3ng b\u0103ng!"
  - language: 40
    text: "\u6211\u4EEC\u88AB\u51BB\u4F4F\u4E86\uFF01"
  - language: 41
    text: "\u6211\u5011\u88AB\u51CD\u4F4F\u4E86\uFF01"
  - language: 42
    text: "\u0939\u092E \u091C\u092E \u0917\u090F \u0939\u0948\u0902!"
