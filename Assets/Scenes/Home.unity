--- !u!114 &1177946011
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1177946009}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86f9205579c3440279820de33163ea4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageTexts:
  - language: 10
    text: Only pure fun!
  - language: 0
    text: Net pure pret!
  - language: 1
    text: "\u0645\u062A\u0639\u0629 \u062E\u0627\u0644\u0635\u0629 \u0641\u0642\u0637!"
  - language: 2
    text: Dibertsio hutsa!
  - language: 3
    text: "\u0422\u043E\u043B\u044C\u043A\u0456 \u0447\u044B\u0441\u0442\u0430\u044F
      \u0432\u0435\u0441\u044F\u043B\u043E\u0441\u0446\u044C!"
  - language: 4
    text: "\u0421\u0430\u043C\u043E \u0447\u0438\u0441\u0442\u043E \u0437\u0430\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435!"
  - language: 5
    text: "Nom\xE9s diversi\xF3!"
  - language: 6
    text: "\u53EA\u6709\u7D14\u7CB9\u7684\u6A02\u8DA3\uFF01"
  - language: 40
    text: "\u53EA\u6709\u7EAF\u7CB9\u7684\u4E50\u8DA3\uFF01"
  - language: 41
    text: "\u53EA\u6709\u7D14\u7CB9\u7684\u6A02\u8DA3\uFF01"
  - language: 7
    text: "Jen \u010Dist\xE1 z\xE1bava!"
  - language: 8
    text: Kun ren sjov!
  - language: 9
    text: Alleen puur plezier!
  - language: 11
    text: "Ainult puhas l\xF5bu!"
  - language: 12
    text: Bara rein stuttleiki!
  - language: 13
    text: Vain puhdasta iloa!
  - language: 14
    text: Que du plaisir !
  - language: 15
    text: "Nur purer Spa\xDF!"
  - language: 16
    text: "\u039C\u03CC\u03BD\u03BF \u03BA\u03B1\u03B8\u03B1\u03C1\u03AE \u03B4\u03B9\u03B1\u03C3\u03BA\u03AD\u03B4\u03B1\u03C3\u03B7!"
  - language: 17
    text: "\u05E8\u05E7 \u05DB\u05D9\u05E3 \u05D8\u05D4\u05D5\u05E8!"
  - language: 18
    text: "Csak tiszta sz\xF3rakoz\xE1s!"
  - language: 19
    text: Bara hrein skemmtun!
  - language: 20
    text: Hanya keseruan murni!
  - language: 21
    text: Solo puro divertimento!
  - language: 22
    text: "\u7D14\u7C8B\u306B\u697D\u3057\u3082\u3046\uFF01"
  - language: 23
    text: "\uC624\uC9C1 \uC21C\uC218\uD55C \uC7AC\uBBF8\uB9CC!"
  - language: 24
    text: "Tikai t\u012Brs prieks!"
  - language: 25
    text: Tik grynas smagumas!
  - language: 26
    text: Bare ren moro!
  - language: 27
    text: Tylko czysta zabawa!
  - language: 28
    text: "S\xF3 divers\xE3o!"
  - language: 29
    text: "Doar distrac\u021Bie pur\u0103!"
  - language: 30
    text: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0438\u0441\u0442\u043E\u0435
      \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435!"
  - language: 31
    text: "Samo \u010Dista zabava!"
  - language: 32
    text: "Len \u010Dist\xE1 z\xE1bava!"
  - language: 33
    text: "Samo \u010Dista zabava!"
  - language: 34
    text: "\xA1Solo diversi\xF3n!"
  - language: 35
    text: "Bara ren spelgl\xE4dje!"
  - language: 36
    text: "\u0E21\u0E35\u0E41\u0E15\u0E48\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E19\u0E38\u0E01\u0E25\u0E49\u0E27\u0E19
      \u0E46!"
  - language: 37
    text: "Sadece saf e\u011Flence!"
  - language: 38
    text: "\u041B\u0438\u0448\u0435 \u0447\u0438\u0441\u0442\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F!"
  - language: 39
    text: "Ch\u1EC9 c\xF3 ni\u1EC1m vui thu\u1EA7n t\xFAy!"
  - language: 42
    text: "\u092C\u0938 \u092D\u0930\u092A\u0942\u0930 \u092E\u091C\u093C\u093E!"
