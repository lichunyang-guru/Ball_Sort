--- !u!114 &853062196
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 853062194}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86f9205579c3440279820de33163ea4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageTexts:
  - language: 10
    text: No timer. No judgment.
  - language: 0
    text: Geen tydhouer. Geen oordeel nie.
  - language: 1
    text: "\u0644\u0627 \u0645\u0624\u0642\u062A. \u0644\u0627 \u0623\u062D\u0643\u0627\u0645."
  - language: 2
    text: Tenporizadorerik ez. Epairik ez.
  - language: 3
    text: "\u0411\u0435\u0437 \u0442\u0430\u0439\u043C\u0435\u0440\u0430. \u0411\u0435\u0437
      \u0430\u0441\u0443\u0434\u0436\u044D\u043D\u043D\u044F."
  - language: 4
    text: "\u0411\u0435\u0437 \u0442\u0430\u0439\u043C\u0435\u0440. \u0411\u0435\u0437
      \u043E\u0446\u0435\u043D\u043A\u0430."
  - language: 5
    text: Sense temporitzador. Sense judicis.
  - language: 6
    text: "\u6C92\u6709\u8A08\u6642\uFF0C\u6C92\u6709\u8A55\u5224\u3002"
  - language: 40
    text: "\u6CA1\u6709\u8BA1\u65F6\uFF0C\u6CA1\u6709\u8BC4\u5224\u3002"
  - language: 41
    text: "\u6C92\u6709\u8A08\u6642\uFF0C\u6C92\u6709\u8A55\u5224\u3002"
  - language: 7
    text: "Bez \u010Dasova\u010De. Bez hodnocen\xED."
  - language: 8
    text: "Ingen timer. Ingen bed\xF8mmelse."
  - language: 9
    text: Geen timer. Geen oordeel.
  - language: 11
    text: Ei taimerit. Ei hinnanguid.
  - language: 12
    text: "Eingin t\xED\xF0teljari. Eingin d\xF8ming."
  - language: 13
    text: Ei ajastinta. Ei arvostelua.
  - language: 14
    text: Pas de chrono. Aucun jugement.
  - language: 15
    text: Kein Timer. Keine Wertung.
  - language: 16
    text: "\u03A7\u03C9\u03C1\u03AF\u03C2 \u03C7\u03C1\u03BF\u03BD\u03CC\u03BC\u03B5\u03C4\u03C1\u03BF.
      \u03A7\u03C9\u03C1\u03AF\u03C2 \u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE."
  - language: 17
    text: "\u05D1\u05DC\u05D9 \u05D8\u05D9\u05D9\u05DE\u05E8. \u05D1\u05DC\u05D9
      \u05E9\u05D9\u05E4\u05D5\u05D8\u05D9\u05D5\u05EA."
  - language: 18
    text: "Nincs id\u0151z\xEDt\u0151. Nincs \xEDt\xE9lkez\xE9s."
  - language: 19
    text: "Enginn t\xEDmam\xE6lir. Engir d\xF3mar."
  - language: 20
    text: Tanpa batas waktu. Tanpa penilaian.
  - language: 21
    text: Nessun timer. Nessun giudizio.
  - language: 22
    text: "\u6642\u9593\u5236\u9650\u306A\u3057\u3002\u8A55\u4FA1\u3082\u306A\u3057\u3002"
  - language: 23
    text: "\uC2DC\uAC04\uC81C\uD55C\uB3C4, \uD3C9\uAC00\uB3C4 \uC5C6\uC5B4\uC694."
  - language: 24
    text: "Bez taimera. Bez v\u0113rt\u0113juma."
  - language: 25
    text: "Be laikma\u010Dio. Be vertinimo."
  - language: 26
    text: "Ingen tidtaking. Ingen bed\xF8mming."
  - language: 27
    text: Bez timera. Bez oceniania.
  - language: 28
    text: "Sem cron\xF4metro. Sem julgamentos."
  - language: 29
    text: "F\u0103r\u0103 cronometru. F\u0103r\u0103 judecat\u0103."
  - language: 30
    text: "\u0411\u0435\u0437 \u0442\u0430\u0439\u043C\u0435\u0440\u0430. \u0411\u0435\u0437
      \u043E\u0446\u0435\u043D\u043E\u043A."
  - language: 31
    text: Bez tajmera. Bez osude.
  - language: 32
    text: "Bez \u010Dasova\u010Da. Bez hodnotenia."
  - language: 33
    text: "Brez \u010Dasovnika. Brez ocenjevanja."
  - language: 34
    text: Sin temporizador. Sin juicios.
  - language: 35
    text: "Ingen timer. Ingen bed\xF6mning."
  - language: 36
    text: "\u0E44\u0E21\u0E48\u0E21\u0E35\u0E08\u0E31\u0E1A\u0E40\u0E27\u0E25\u0E32
      \u0E44\u0E21\u0E48\u0E21\u0E35\u0E15\u0E31\u0E14\u0E2A\u0E34\u0E19"
  - language: 37
    text: "S\xFCre yok. Yarg\u0131lama yok."
  - language: 38
    text: "\u0411\u0435\u0437 \u0442\u0430\u0439\u043C\u0435\u0440\u0430. \u0411\u0435\u0437
      \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F."
  - language: 39
    text: "Kh\xF4ng gi\u1EDBi h\u1EA1n th\u1EDDi gian. Kh\xF4ng ph\xE1n x\xE9t."
  - language: 42
    text: "\u0928 \u0915\u094B\u0908 \u091F\u093E\u0907\u092E\u0930, \u0928 \u0915\u094B\u0908
      \u092B\u0948\u0938\u0932\u093E\u0964"
