  m_Script: {fileID: 11500000, guid: 86f9205579c3440279820de33163ea4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageTexts:
  - language: 40
    text: "\u611F\u6069\u8282\u5FEB\u4E50"
  - language: 0
    text: Gelukkige Dankfees
  - language: 1
    text: "\u0639\u064A\u062F \u0634\u0643\u0631 \u0633\u0639\u064A\u062F"
  - language: 2
    text: Eskerrak emateko egun on
  - language: 3
    text: "\u0417 \u0414\u043D\u0451\u043C \u041F\u0430\u0434\u0437\u044F\u043A\u0456"
  - language: 4
    text: "\u0427\u0435\u0441\u0442\u0438\u0442 \u0414\u0435\u043D \u043D\u0430 \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0442\u0430"
  - language: 5
    text: "Feli\xE7 Dia d'Acci\xF3 de Gr\xE0cies"
  - language: 6
    text: "\u611F\u6069\u7BC0\u5FEB\u6A02"
  - language: 41
    text: "\u611F\u6069\u7BC0\u5FEB\u6A02"
  - language: 7
    text: "\u0160\u0165astn\xFD Den d\xEDk\u016Fvzd\xE1n\xED"
  - language: 8
    text: God Thanksgiving
  - language: 9
    text: Gelukkige Thanksgiving
  - language: 10
    text: Happy Thanksgiving
  - language: 11
    text: "Head t\xE4nup\xFCha"
  - language: 12
    text: "G\xF3\xF0 takkadagur"
  - language: 13
    text: "Hyv\xE4\xE4 kiitosp\xE4iv\xE4\xE4"
  - language: 14
    text: Joyeux Thanksgiving
  - language: 15
    text: Frohes Erntedankfest
  - language: 16
    text: "\u03A7\u03C1\u03CC\u03BD\u03B9\u03B1 \u03A0\u03BF\u03BB\u03BB\u03AC \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u0397\u03BC\u03AD\u03C1\u03B1 \u03C4\u03C9\u03BD \u0395\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03B9\u03CE\u03BD"
  - language: 17
    text: "\u05D7\u05D2 \u05D4\u05D5\u05D3\u05D9\u05D4 \u05E9\u05DE\u05D7"
  - language: 18
    text: "Boldog H\xE1laad\xE1s Napj\xE1t"
  - language: 19
    text: "Gle\xF0ilegan \xFEakkargj\xF6r\xF0ardag"
  - language: 20
    text: Selamat Hari Thanksgiving
  - language: 21
    text: Buon Giorno del Ringraziamento
  - language: 22
    text: "\u611F\u8B1D\u796D\u304A\u3081\u3067\u3068\u3046"
  - language: 23
    text: "\uCD94\uC218\uAC10\uC0AC\uC808 \uCD95\uD558\uD574\uC694"
  - language: 24
    text: "Laim\u012Bgu Pateic\u012Bbas dienu"
  - language: 25
    text: "Laimingos Pad\u0117kos dienos"
  - language: 26
    text: God Thanksgiving
  - language: 27
    text: "Szcz\u0119\u015Bliwego \u015Awi\u0119ta Dzi\u0119kczynienia"
  - language: 28
    text: "Feliz Dia de A\xE7\xE3o de Gra\xE7as"
  - language: 29
    text: "Ziua Recuno\u0219tin\u021Bei Fericit\u0103"
  - language: 30
    text: "\u0421 \u0414\u043D\u0451\u043C \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D\u0438\u044F"
  - language: 31
    text: Sretan Dan zahvalnosti
  - language: 32
    text: "\u0160\u0165astn\xFD De\u0148 v\u010Fakyvzdania"
  - language: 33
    text: Vesel dan zahvale
  - language: 34
    text: "Feliz D\xEDa de Acci\xF3n de Gracias"
  - language: 35
    text: Glad Thanksgiving
  - language: 36
    text: "\u0E2A\u0E38\u0E02\u0E2A\u0E31\u0E19\u0E15\u0E4C\u0E27\u0E31\u0E19\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E1E\u0E23\u0E30\u0E40\u0E08\u0E49\u0E32"
  - language: 37
    text: "\u015E\xFCkran G\xFCn\xFC Kutlu Olsun"
  - language: 38
    text: "\u0417 \u0414\u043D\u0435\u043C \u041F\u043E\u0434\u044F\u043A\u0438"
  - language: 39
    text: "Ch\xFAc M\u1EEBng L\u1EC5 T\u1EA1 \u01A0n"
  - language: 42
    text: "\u0927\u0928\u094D\u092F\u0935\u093E\u0926 \u0926\u093F\u0935\u0938 \u0915\u0940
      \u0936\u0941\u092D\u0915\u093E\u092E\u0928\u093E\u090F\u0902"
  translationJsonText: "{\"Afrikaans\": \"Gelukkige Dankfees\", \"Arabic\": \"\u0639\u064A\u062F
    \u0634\u0643\u0631 \u0633\u0639\u064A\u062F\", \"Basque\": \"Eskerrak emateko
    egun on\", \"Belarusian\": \"\u0417 \u0414\u043D\u0451\u043C \u041F\u0430\u0434\u0437\u044F\u043A\u0456\",
    \"Bulgarian\": \"\u0427\u0435\u0441\u0442\u0438\u0442 \u0414\u0435\u043D \u043D\u0430
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0442\u0430\",
    \"Catalan\": \"Feli\xE7 Dia d'Acci\xF3 de Gr\xE0cies\", \"Chinese\": \"\u611F\u6069\u7BC0\u5FEB\u6A02\",
