--- !u!114 &1814863278
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1814863275}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86f9205579c3440279820de33163ea4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageTexts:
  - language: 10
    text: Try to solve this
  - language: 0
    text: Probeer dit oplos
  - language: 1
    text: "\u062D\u0627\u0648\u0644 \u062D\u0644 \u0647\u0630\u0627"
  - language: 2
    text: Saiatu hau ebazten
  - language: 3
    text: "\u041F\u0430\u0441\u043F\u0440\u0430\u0431\u0443\u0439\u0446\u0435 \u0432\u044B\u0440\u0430\u0448\u044B\u0446\u044C
      \u0433\u044D\u0442\u0430"
  - language: 4
    text: "\u041E\u043F\u0438\u0442\u0430\u0439 \u0441\u0435 \u0434\u0430 \u0433\u043E
      \u0440\u0435\u0448\u0438\u0448"
  - language: 5
    text: "Intenta resoldre aix\xF2"
  - language: 6
    text: "\u8BD5\u7740\u89E3\u5F00\u5B83"
  - language: 7
    text: "Zkus to vy\u0159e\u0161it"
  - language: 8
    text: "Pr\xF8v at l\xF8se dette"
  - language: 9
    text: Probeer dit op te lossen
  - language: 11
    text: Proovi see lahendada
  - language: 12
    text: Royn at loysa hetta
  - language: 13
    text: "Yrit\xE4 ratkaista t\xE4m\xE4"
  - language: 14
    text: "Essaie de r\xE9soudre \xE7a"
  - language: 15
    text: "Versuche, das zu l\xF6sen"
  - language: 16
    text: "\u03A0\u03C1\u03BF\u03C3\u03C0\u03AC\u03B8\u03B7\u03C3\u03B5 \u03BD\u03B1
      \u03C4\u03BF \u03BB\u03CD\u03C3\u03B5\u03B9\u03C2"
  - language: 17
    text: "\u05E0\u05E1\u05D5 \u05DC\u05E4\u05EA\u05D5\u05E8 \u05D0\u05EA \u05D6\u05D4"
  - language: 18
    text: "Pr\xF3b\xE1ld megoldani ezt"
  - language: 19
    text: "Reyndu a\xF0 leysa \xFEetta"
  - language: 20
    text: Coba selesaikan ini
  - language: 21
    text: Prova a risolvere questo
  - language: 22
    text: "\u3053\u308C\u3092\u89E3\u3044\u3066\u307F\u3066"
  - language: 23
    text: "\uC774\uAC78 \uD480\uC5B4 \uBCF4\uC138\uC694"
  - language: 24
    text: "M\u0113\u0123ini to atrisin\u0101t"
  - language: 25
    text: "Pabandyk tai i\u0161spr\u0119sti"
  - language: 26
    text: "Pr\xF8v \xE5 l\xF8se dette"
  - language: 27
    text: "Spr\xF3buj to rozwi\u0105za\u0107"
  - language: 28
    text: Tente resolver isto
  - language: 29
    text: "\xCEncearc\u0103 s\u0103 rezolvi asta"
  - language: 30
    text: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0440\u0435\u0448\u0438\u0442\u044C
      \u044D\u0442\u043E"
  - language: 31
    text: "Poku\u0161aj to rije\u0161iti"
  - language: 32
    text: "Sk\xFAs to vyrie\u0161i\u0165"
  - language: 33
    text: "Poskusi to re\u0161iti"
  - language: 34
    text: Intenta resolver esto
  - language: 35
    text: "F\xF6rs\xF6k att l\xF6sa det h\xE4r"
  - language: 36
    text: "\u0E25\u0E2D\u0E07\u0E41\u0E01\u0E49\u0E1B\u0E31\u0E0D\u0E2B\u0E32\u0E19\u0E35\u0E49"
  - language: 37
    text: "Bunu \xE7\xF6zmeyi dene"
  - language: 38
    text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0439 \u0440\u043E\u0437\u0432'\u044F\u0437\u0430\u0442\u0438
      \u0446\u0435"
  - language: 39
    text: "H\xE3y th\u1EED gi\u1EA3i c\xE1i n\xE0y"
  - language: 40
    text: "\u8BD5\u7740\u89E3\u5F00\u5B83"
  - language: 41
    text: "\u8A66\u8457\u89E3\u958B\u5B83"
  - language: 42
    text: "\u0907\u0938\u0947 \u0939\u0932 \u0915\u0930\u0928\u0947 \u0915\u0940
      \u0915\u094B\u0936\u093F\u0936 \u0915\u0930\u0947\u0902"
  translationJsonText: 
