    \u03C4\u03C9\u03BD \u0395\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03B9\u03CE\u03BD\",
    \"Hebrew\": \"\u05D7\u05D2 \u05D4\u05D5\u05D3\u05D9\u05D4 \u05E9\u05DE\u05D7\",
